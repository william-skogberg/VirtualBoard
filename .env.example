# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/virtualboard
# Set this to a long random secret (e.g. generated with a password manager)
JWT_SECRET=replace-with-a-long-random-secret
PORT=4001
ALLOWED_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12
REFRESH_TOKEN_TTL_DAYS=30
